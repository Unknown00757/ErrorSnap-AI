# ErrorSnap AI – Frontend Environment Variables
# ──────────────────────────────────────────────────
# Optional: Base URL for the Flask backend.
# If omitted or left empty, Vite's dev server proxy (/api -> http://localhost:5000) is used.
# In production, set this to your backend domain (e.g., https://api.errorsnap.ai)
VITE_API_BASE_URL=

# SECURITY NOTICE:
# Never put GEMINI_API_KEY or FLASK_SECRET_KEY in frontend environment variables.
# All AI calls and credentials are managed securely by the Flask backend.
