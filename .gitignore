# ──────────────────────────────────────────────
# ErrorSnap AI – .gitignore
# ──────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Flask / backend
backend/uploads/*
!backend/uploads/.gitkeep
backend/.env

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
