# ──────────────────────────────────────────────────────────────
# ErrorSnap AI – Environment Variables Template
#
# Copy this file to `.env` and fill in your real values.
# NEVER commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────

# Google Gemini API key (used to access the Gemma 4 model)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask secret key (used for session security – any random string works)
FLASK_SECRET_KEY=change_this_to_a_random_secret_string

# Maximum allowed upload file size in bytes (default: 10 MB)
MAX_CONTENT_LENGTH=10485760

# Folder where uploaded screenshots are temporarily stored
UPLOAD_FOLDER=uploads
